/* Trading Replay Lab - Sleek Modern Dark Theme */

QMainWindow {
    background-color: #131722;
    color: #d1d4dc;
}

QWidget {
    background-color: #131722;
    color: #d1d4dc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    font-size: 12px;
}

QMenuBar {
    background-color: #1e222d;
    color: #d1d4dc;
    border-bottom: 1px solid #2a2e39;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2a2e39;
    color: #ffffff;
}

QMenu {
    background-color: #1e222d;
    color: #d1d4dc;
    border: 1px solid #2a2e39;
    padding: 4px;
    border-radius: 6px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2962ff;
    color: #ffffff;
}

QToolBar {
    background-color: #1e222d;
    border-bottom: 1px solid #2a2e39;
    spacing: 6px;
    padding: 4px 8px;
}

QPushButton {
    background-color: #2a2e39;
    color: #d1d4dc;
    border: 1px solid #363c4e;
    border-radius: 4px;
    padding: 5px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #363c4e;
    color: #ffffff;
    border-color: #4a5065;
}

QPushButton:pressed {
    background-color: #1e222d;
}

QPushButton#buyButton {
    background-color: #26a69a;
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 13px;
    padding: 8px 16px;
}

QPushButton#buyButton:hover {
    background-color: #2bbbad;
}

QPushButton#sellButton {
    background-color: #ef5350;
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 13px;
    padding: 8px 16px;
}

QPushButton#sellButton:hover {
    background-color: #f44336;
}

QPushButton#closeButton {
    background-color: #363c4e;
    color: #ff9800;
    font-weight: 600;
    border: 1px solid #ff9800;
}

QPushButton#closeButton:hover {
    background-color: #ff9800;
    color: #131722;
}

QPushButton#toolButtonActive {
    background-color: #2962ff;
    color: #ffffff;
    border-color: #2962ff;
}

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    background-color: #1e222d;
    color: #ffffff;
    border: 1px solid #363c4e;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #2962ff;
}

QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}

QTabWidget::pane {
    border-top: 1px solid #2a2e39;
    background-color: #131722;
}

QTabBar::tab {
    background-color: #1e222d;
    color: #848e9c;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #131722;
    color: #ffffff;
    border-top: 2px solid #2962ff;
}

QTableWidget {
    background-color: #131722;
    color: #d1d4dc;
    border: 1px solid #1e222d;
    gridline-color: #1e222d;
    selection-background-color: #2a2e39;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #1e222d;
    color: #848e9c;
    border: none;
    border-bottom: 1px solid #2a2e39;
    border-right: 1px solid #1e222d;
    padding: 6px;
    font-weight: 600;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #2a2e39;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #2962ff;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #2962ff;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #131722;
    width: 8px;
    height: 8px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #2a2e39;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #363c4e;
}

QStatusBar {
    background-color: #1e222d;
    color: #848e9c;
    border-top: 1px solid #2a2e39;
}

QGroupBox {
    border: 1px solid #2a2e39;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 10px;
    font-weight: 600;
    color: #848e9c;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}
